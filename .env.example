# Copy to `.env` and fill in your secrets. `.env` is gitignored; this template
# carries NO secrets — only placeholders and where to obtain each value.
# Run scripts/test-api-keys.ps1 to verify all keys after filling.
#
# Grouped INFRASTRUCTURE (platform substrate) / DATA SERVICES (trading pack),
# following the ADR-0012 wall: no trading concept belongs in the substrate.
# Agent tunables are namespaced by env prefix (PROVIDER_, ANALYST_, …) and are
# bounds-checked on load. Full catalogue: docs/configuration.md.

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ INFRASTRUCTURE — domain-agnostic platform substrate.                     ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Graph spine — the system of record (ADR-0014) — REQUIRED ────────────────
# Schema is Alembic-owned:
#   uv run --extra runtime --extra postgres alembic -c infra/migrations/alembic.ini upgrade head
# Use the direct Neon/Postgres host with TLS; never commit the filled value.
# Absent => kernel/graph_env.py falls back to the in-memory store (local dev).
POSTGRES_DSN=

# ── Message bus — inter-agent pub/sub (ADR-0005) — REQUIRED for live runs ───
# Root SAS, used by local scripts. The deployed fleet does NOT use this: the
# master delivers per-agent entity-level SAS (S133). Also accepted as
# AZURE_SERVICEBUS_CONNECTION_STRING.
SERVICEBUS_CONNECTION_STRING=

# ── LLM providers — operator agent + deliberation debate — REQUIRED ─────────
# LLM_PROVIDER selects the backend at startup; the runtime fallback may switch
# it dynamically (quota/error), and the in-flight value wins over this file.
# Both providers need valid keys for fallback to work.
LLM_PROVIDER=openai                          # openai | anthropic
# https://console.anthropic.com -> Settings -> API Keys
# Verify: curl https://api.anthropic.com/v1/models -H "x-api-key: <key>" -H "anthropic-version: 2023-06-01"
ANTHROPIC_API_KEY=
# Read ONLY by scripts/deliberate.py, remediation_gate.py, mine_factors.py
# (each defaults to claude-sonnet-4-6). It does NOT reach the operator agent —
# OperatorSettings uses env_prefix=OPERATOR_, so that knob is OPERATOR_MODEL.
ANTHROPIC_MODEL=claude-opus-5
# output_config effort for the script-side Anthropic calls: low|medium|high|xhigh|max
ANTHROPIC_EFFORT=max
# The operator agent's own model (OperatorSettings, env_prefix=OPERATOR_). Its code
# default is claude-sonnet-4-6; this points it at Opus. Effort defaults to max.
OPERATOR_MODEL=claude-opus-5
# https://platform.openai.com/api-keys
# Verify: curl https://api.openai.com/v1/models -H "Authorization: Bearer <key>"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=high                 # low | medium | high
# Debate Judge (ADR-0010). Defender/Challenger use LLM_PROVIDER above.
# NOT the EXP-004 LLMJudgeScorer, which stays pinned to the champion.
DELIBERATION_JUDGE_PROVIDER=anthropic
DELIBERATION_JUDGE_MODEL=claude-opus-4-8

# ── Azure identity — app registration used by the agents ────────────────────
# AZURE_SUBSCRIPTION_ID is not a secret; AZURE_CLIENT_SECRET rotates every 90 days.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Azure Container Apps — the deployed fleet ───────────────────────────────
# Written by infra/setup-container-apps.ps1.
AZURE_CA_ENV_NAME=
AZURE_CA_ENV_ID=
AZURE_CA_DEFAULT_DOMAIN=
AZURE_LA_WORKSPACE_ID=

# ── Observability — Application Insights + Log Analytics (ADR-0003) ─────────
# Stream names are NOT env-driven — they are fixed in infra/observability.bicep.
AZURE_OBSERVABILITY_ENABLED=false            # true | false
# MONITOR_CONNECTION_STRING: App Insights -> Connection String tab.
# LOGS_INGESTION_ENDPOINT: Data Collection Endpoint URL.
# LOGS_DCR_IMMUTABLE_ID: Data Collection Rule immutable id (dcr-…).
AZURE_MONITOR_CONNECTION_STRING=
AZURE_LOGS_INGESTION_ENDPOINT=
AZURE_LOGS_DCR_IMMUTABLE_ID=

# ── Metrics — Prometheus remote-write into Azure Monitor ────────────────────
# Separate service principal, set by infra/setup-prometheus-auth.ps1.
# AZURE_SP_CLIENT_SECRET rotates every 90 days.
# PROMETHEUS_REMOTE_WRITE_URL: https://<workspace>.prometheus.monitor.azure.com/api/v1/write
AZURE_SP_CLIENT_ID=
AZURE_SP_CLIENT_SECRET=
AZURE_SP_TENANT_ID=
PROMETHEUS_REMOTE_WRITE_URL=

# ── Dashboard + deploy currency ─────────────────────────────────────────────
DASHBOARD_AZURE_CREDENTIAL_MODE=cli          # cli | serviceprincipal
# GITHUB_TOKEN: PAT with read:packages (GHCR pull + the DL-46 deploy-currency check).
GITHUB_TOKEN=

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ DATA SERVICES — trading-pack vendors. REQUIRED for live runs.            ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Broker: Alpaca paper (execution agent, ADR-0006) ────────────────────────
# https://app.alpaca.markets/paper-trading -> API Keys
# Verify: curl https://paper-api.alpaca.markets/v2/account -H "APCA-API-KEY-ID: <key>" -H "APCA-API-SECRET-KEY: <secret>"
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Paper-specific alias; wins over ALPACA_API_KEY so a live key is never picked
# up by accident (agents/execution/settings.py, probes/checks.py).
ALPACA_PAPER_API_KEY=
# NOTE: consumers disagree on the /v2 suffix — scripts/test-api-keys.ps1 appends
# "/account" (needs it), trading_vault_probes.py appends "/v2/account" (must not).
# The execution agent ignores this var; it reads EXECUTION_ALPACA_BASE_URL /
# ALPACA_BASE_URL, default https://paper-api.alpaca.markets.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2   # https://api.alpaca.markets for live

# ── Market data: Alpaca primary, Tiingo fallback + history (ADR-0006) ───────
# PROVIDER_-prefixed names are the canonical ones (pydantic env_prefix); the
# bare names are read by scripts/test-api-keys.ps1 and probes/checks.py.
PROVIDER_ALPACA_API_KEY=
PROVIDER_ALPACA_API_SECRET=
# Tiingo: 500 symbols/mo, 50 req/hr — see docs/laws/tiingo-usage-limits.md
# https://www.tiingo.com/account/api/token
# Verify: curl https://api.tiingo.com/api/test -H "Authorization: Token <key>"
TIINGO_API_KEY=
PROVIDER_TIINGO_API_KEY=

# ── Fundamentals, macro, validation ─────────────────────────────────────────
# Finnhub — fundamentals + news. https://finnhub.io/register
# Verify: curl "https://finnhub.io/api/v1/quote?symbol=AAPL&token=<key>"
PROVIDER_FINNHUB_API_KEY=
# FRED — macro/regime inputs. https://fredaccount.stlouisfed.org/apikeys
# Verify: curl "https://api.stlouisfed.org/fred/series?series_id=GDP&api_key=<key>&file_type=json"
PROVIDER_FRED_API_KEY=
# FinancialModelingPrep — two DIFFERENT keys, both live:
#   PROVIDER_FMP_API_KEY -> FMPDataSource (vault-seeded, orchestration/packs)
#   FNP_API_KEY          -> DEP-FEED-01 "OHLCV: FMP live" probe (probes/checks.py)
# Verify: curl "https://financialmodelingprep.com/stable/search-symbol?query=AAPL&apikey=<key>"
# Use the /stable/ endpoints; /api/v3 requires a higher plan.
PROVIDER_FMP_API_KEY=
FNP_API_KEY=

# ── News sentiment: Alpha Vantage (challenger, ADR-0002) ────────────────────
# Free key (~20s): https://www.alphavantage.co/support/#api-key
# Verify: curl "https://www.alphavantage.co/query?function=NEWS_SENTIMENT&tickers=AAPL&limit=1&apikey=<key>"
#   (a real key returns feed[].ticker_sentiment[].ticker_sentiment_score; demo is gated)
ALPHAVANTAGE_API_KEY=
PROVIDER_ALPHAVANTAGE_API_KEY=

# ── ML models: FinBERT advisory sentiment (forecaster) ──────────────────────
# https://huggingface.co/settings/tokens
# Verify: curl https://huggingface.co/api/whoami-v2 -H "Authorization: Bearer <token>"
HF_TOKEN=

# ── Example agent tunables (illustrative — each agent owns its own) ─────────
# PROVIDER_FINNHUB_BASE_URL=https://finnhub.io/api/v1
# ANALYST_RELATIVE_STRENGTH_WEIGHT=0.20
# PORTFOLIO_MANAGER_MAX_POSITION_PCT=0.05    # float 0.01–0.20
# PORTFOLIO_MANAGER_MIN_REWARD_RISK_RATIO=1.5
