{
  "provider": [
    {
      "name": "tiingo",
      "kind": "http_status",
      "method": "GET",
      "url": "https://api.tiingo.com/api/test",
      "headers": { "Authorization": "Token {PROVIDER_TIINGO_API_KEY}" },
      "expected_statuses": [200],
      "credential_failure_statuses": [401, 403],
      "required": false,
      "cost": "cheap"
    },
    {
      "name": "finnhub",
      "kind": "http_status",
      "method": "GET",
      "url": "https://finnhub.io/api/v1/quote",
      "headers": { "X-Finnhub-Token": "{PROVIDER_FINNHUB_API_KEY}" },
      "query": { "symbol": "AAPL" },
      "expected_statuses": [200],
      "credential_failure_statuses": [401, 403, 429],
      "required": false,
      "cost": "cheap"
    },
    {
      "name": "fmp",
      "kind": "http_status",
      "method": "GET",
      "url": "https://financialmodelingprep.com/stable/profile",
      "query": { "symbol": "AAPL", "apikey": "{PROVIDER_FMP_API_KEY}" },
      "expected_statuses": [200],
      "credential_failure_statuses": [401, 402, 403, 429],
      "required": false,
      "cost": "cheap"
    },
    {
      "name": "alpaca-data",
      "kind": "http_status",
      "method": "GET",
      "url": "https://data.alpaca.markets/v2/stocks/AAPL/trades/latest",
      "headers": {
        "APCA-API-KEY-ID": "{PROVIDER_ALPACA_API_KEY}",
        "APCA-API-SECRET-KEY": "{PROVIDER_ALPACA_API_SECRET}"
      },
      "query": { "feed": "iex" },
      "expected_statuses": [200],
      "credential_failure_statuses": [401, 403],
      "required": true,
      "cost": "cheap"
    }
  ],
  "execution": [
    {
      "name": "alpaca-broker",
